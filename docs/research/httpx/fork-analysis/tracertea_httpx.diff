+func extractCPEs(fingerprintMatch []*recog.FingerprintMatch, title string, matchType string) RecogCPE {
+	var cpes []map[string]string
+	for _, match := range fingerprintMatch {
+		cpes = append(cpes, match.Values)
+	}
+	titleRecogCPE := RecogCPE{
+		Match: title,
+		Type:  matchType,
+		CPEs:  cpes,
+	}
+	return titleRecogCPE
+}
