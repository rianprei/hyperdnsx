@@ -0,0 +1,118 @@
+name: Fork maintenance dashboard
+
+on:
+  schedule:
+    - cron: "45 10 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  actions: read
+  pull-requests: read
+  issues: write
+
+env:
+  UPSTREAM_REPOSITORY: projectdiscovery/httpx
+  BASE_BRANCH: dev
+  DASHBOARD_TITLE: httpx fork maintenance dashboard
+
+jobs:
+  dashboard:
+    name: Update maintenance issue
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout fork
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ env.BASE_BRANCH }}
+          fetch-depth: 0
+
+      - name: Update dashboard issue
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          git remote add upstream "https://github.com/${UPSTREAM_REPOSITORY}.git"
+          git fetch origin "${BASE_BRANCH}"
+          git fetch upstream "${BASE_BRANCH}"
+
+          fork_sha="$(git rev-parse --short "origin/${BASE_BRANCH}")"
+          upstream_sha="$(git rev-parse --short "upstream/${BASE_BRANCH}")"
+          ahead_count="$(git rev-list --count "upstream/${BASE_BRANCH}..origin/${BASE_BRANCH}")"
+          behind_count="$(git rev-list --count "origin/${BASE_BRANCH}..upstream/${BASE_BRANCH}")"
+
+          if git merge-base --is-ancestor "upstream/${BASE_BRANCH}" "origin/${BASE_BRANCH}"; then
+            upstream_status="contained"
+          else
+            upstream_status="behind upstream"
+          fi
+
+          latest_sync="$(gh run list \
+            --repo "${GITHUB_REPOSITORY}" \
+            --limit 20 \
+            --json workflowName,status,conclusion,event,createdAt,url \
+            --jq '[.[] | select(.workflowName == "Sync upstream dev")][0] // empty | "\(.status) / \(.conclusion // "n/a") via \(.event) at \(.createdAt) - \(.url)"')"
+          if [ -z "$latest_sync" ]; then
+            latest_sync="No sync runs found"
+          fi
+
+          open_sync_prs="$(gh pr list \
+            --repo "${GITHUB_REPOSITORY}" \
+            --base "${BASE_BRANCH}" \
+            --head automation/sync-upstream-dev \
+            --state open \
+            --json number,title,url,mergeStateStatus \
+            --jq 'if length == 0 then "None" else map("#\(.number) \(.title) [\(.mergeStateStatus)] - \(.url)") | join("\n") end')"
+
+          blocked_issue="$(gh issue list \
+            --repo "${GITHUB_REPOSITORY}" \
+            --state open \
+            --search "Upstream httpx sync blocked in:title" \
+            --json number,title,url \
+            --jq 'if length == 0 then "None" else map("#\(.number) \(.title) - \(.url)") | join("\n") end')"
+
+          body_file="$(mktemp)"
+          {
+            echo "Automated fork-maintenance snapshot."
+            echo
+            echo "| Check | Value |"
+            echo "| --- | --- |"
+            echo "| Fork branch | ${BASE_BRANCH} @ ${fork_sha} |"
+            echo "| Upstream branch | ${UPSTREAM_REPOSITORY}:${BASE_BRANCH} @ ${upstream_sha} |"
+            echo "| Upstream status | ${upstream_status} |"
+            echo "| Fork-only commits ahead | ${ahead_count} |"
+            echo "| Upstream commits behind | ${behind_count} |"
+            echo "| Latest sync run | ${latest_sync} |"
+            echo
+            echo "Open upstream sync PRs:"
+            echo '```'
+            printf '%s\n' "$open_sync_prs"
+            echo '```'
+            echo
+            echo "Open blocked-sync issue:"
+            echo '```'
+            printf '%s\n' "$blocked_issue"
+            echo '```'
+            echo
+            echo "Updated by ${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}."
+          } > "$body_file"
+
+          if [ "$(gh repo view "${GITHUB_REPOSITORY}" --json hasIssuesEnabled --jq '.hasIssuesEnabled')" != "true" ]; then
+            {
+              echo "Issues are disabled for ${GITHUB_REPOSITORY}; writing dashboard to the workflow summary instead."
+              echo
+              cat "$body_file"
+            } >> "$GITHUB_STEP_SUMMARY"
+            exit 0
+          fi
+
+          gh label create maintenance \
+            --repo "${GITHUB_REPOSITORY}" \
+            --color "5319E7" \
+            --description "Maintenance tracking" || true
+
+          issue_number="$(gh issue list --repo "${GITHUB_REPOSITORY}" --state open --search "${DASHBOARD_TITLE} in:title" --json number,title --jq ".[] | select(.title == \"${DASHBOARD_TITLE}\") | .number" | head -n 1)"
+          if [ -n "$issue_number" ]; then
+            gh issue edit "$issue_number" --repo "${GITHUB_REPOSITORY}" --body-file "$body_file" --add-label maintenance
+          else
+            gh issue create --repo "${GITHUB_REPOSITORY}" --title "$DASHBOARD_TITLE" --body-file "$body_file" --label maintenance
+          fi
