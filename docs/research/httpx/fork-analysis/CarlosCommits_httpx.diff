@@ -0,0 +1,283 @@
+name: Sync upstream dev
+
+on:
+  schedule:
+    - cron: "17 10 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: write
+  pull-requests: write
+  issues: write
+
+env:
+  UPSTREAM_REPOSITORY: projectdiscovery/httpx
+  BASE_BRANCH: dev
+  SYNC_BRANCH: automation/sync-upstream-dev
+
+jobs:
+  sync:
+    name: Create upstream sync PR
+    runs-on: ubuntu-latest
+    outputs:
+      has_changes: ${{ steps.sync.outputs.has_changes }}
+      pr_number: ${{ steps.pr.outputs.pr_number }}
+      risky_sync: ${{ steps.sync.outputs.risky_sync }}
+      changed_files: ${{ steps.sync.outputs.changed_files }}
+    steps:
+      - name: Checkout fork
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ env.BASE_BRANCH }}
+          fetch-depth: 0
+          token: ${{ secrets.UPSTREAM_SYNC_TOKEN || github.token }}
+
+      - name: Configure git
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+
+      - name: Merge upstream dev
+        id: sync
+        run: |
+          git remote add upstream "https://github.com/${UPSTREAM_REPOSITORY}.git"
+          git fetch origin "${BASE_BRANCH}"
+          git fetch upstream "${BASE_BRANCH}"
+          git switch -C "${SYNC_BRANCH}" "origin/${BASE_BRANCH}"
+
+          if git merge-base --is-ancestor "upstream/${BASE_BRANCH}" HEAD; then
+            echo "Fork ${BASE_BRANCH} already contains upstream/${BASE_BRANCH}."
+            echo "has_changes=false" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+
+          git merge --no-edit "upstream/${BASE_BRANCH}"
+
+          if [ "$(git rev-list --count "origin/${BASE_BRANCH}..HEAD")" = "0" ]; then
+            echo "No sync commits to push."
+            echo "has_changes=false" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+
+          changed_files="$(git diff --name-only "origin/${BASE_BRANCH}..HEAD")"
+          risky_sync=false
+          if printf '%s\n' "$changed_files" | grep -E '^(runner/|common/httpx/|cmd/httpx/|go\.mod|go\.sum)' >/dev/null; then
+            risky_sync=true
+          fi
+          if printf '%s\n' "$changed_files" | grep -Ei '(wappalyzer|fingerprint|headless|tech)' >/dev/null; then
+            risky_sync=true
+          fi
+
+          git push --force-with-lease origin "HEAD:${SYNC_BRANCH}"
+          echo "has_changes=true" >> "$GITHUB_OUTPUT"
+          echo "risky_sync=${risky_sync}" >> "$GITHUB_OUTPUT"
+          {
+            echo "changed_files<<EOF"
+            printf '%s\n' "$changed_files"
+            echo "EOF"
+          } >> "$GITHUB_OUTPUT"
+
+      - name: Create or update pull request
+        id: pr
+        if: steps.sync.outputs.has_changes == 'true'
+        env:
+          GH_TOKEN: ${{ secrets.UPSTREAM_SYNC_TOKEN || github.token }}
+          RISKY_SYNC: ${{ steps.sync.outputs.risky_sync }}
+          CHANGED_FILES: ${{ steps.sync.outputs.changed_files }}
+        run: |
+          gh label create upstream-sync \
+            --repo "${GITHUB_REPOSITORY}" \
+            --color "0E8A16" \
+            --description "Automated upstream synchronization" || true
+          gh label create needs-review \
+            --repo "${GITHUB_REPOSITORY}" \
+            --color "D93F0B" \
+            --description "Requires human review before merge" || true
+
+          body_file="$(mktemp)"
+          {
+            echo "Automated merge of projectdiscovery/httpx dev into this fork."
+            echo
+            echo "- Upstream: ${UPSTREAM_REPOSITORY}:${BASE_BRANCH}"
+            echo "- Base branch: ${BASE_BRANCH}"
+            echo "- Risk-sensitive files changed: ${RISKY_SYNC}"
+            echo
+            echo "Changed files:"
+            echo '```'
+            printf '%s\n' "${CHANGED_FILES}"
+            echo '```'
+          } > "$body_file"
+
+          pr_number="$(gh pr list \
+            --repo "${GITHUB_REPOSITORY}" \
+            --base "${BASE_BRANCH}" \
+            --head "${SYNC_BRANCH}" \
+            --json number \
+            --jq '.[0].number')"
+
+          if [ -z "$pr_number" ]; then
+            pr_url="$(gh pr create \
+              --repo "${GITHUB_REPOSITORY}" \
+              --base "${BASE_BRANCH}" \
+              --head "${SYNC_BRANCH}" \
+              --title "chore: sync upstream dev" \
+              --body-file "$body_file")"
+            pr_number="$(gh pr view "$pr_url" --repo "${GITHUB_REPOSITORY}" --json number --jq '.number')"
+          else
+            gh pr edit "$pr_number" \
+              --repo "${GITHUB_REPOSITORY}" \
+              --title "chore: sync upstream dev" \
+              --body-file "$body_file"
+          fi
+
+          gh pr edit "$pr_number" --repo "${GITHUB_REPOSITORY}" --add-label upstream-sync
+          if [ "${RISKY_SYNC}" = "true" ]; then
+            gh pr edit "$pr_number" --repo "${GITHUB_REPOSITORY}" --add-label needs-review
+          fi
+
+          echo "pr_number=$pr_number" >> "$GITHUB_OUTPUT"
+
+  validate:
+    name: Validate sync (${{ matrix.os }})
+    needs: sync
+    if: needs.sync.outputs.has_changes == 'true'
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, windows-latest, macos-latest]
+    steps:
+      - name: Checkout sync branch
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ env.SYNC_BRANCH }}
+          fetch-depth: 0
+
+      - name: Setup Go
+        uses: actions/setup-go@v5
+        with:
+          go-version-file: go.mod
+          cache: true
+
+      - name: Build httpx
+        run: go build .
+        working-directory: cmd/httpx
+
+      - name: Stackray contract tests
+        run: go test ./runner -run TestStackrayContract -count=1
+
+      - name: Test
+        run: go test ./...
+
+  merge:
+    name: Merge validated sync PR
+    needs: [sync, validate]
+    if: needs.sync.outputs.has_changes == 'true' && needs.sync.outputs.risky_sync != 'true'
+    runs-on: ubuntu-latest
+    steps:
+      - name: Merge PR
+        id: merge-pr
+        env:
+          GH_TOKEN: ${{ secrets.UPSTREAM_SYNC_TOKEN || github.token }}
+          PR_NUMBER: ${{ needs.sync.outputs.pr_number }}
+        run: |
+          gh pr merge "$PR_NUMBER" \
+            --repo "${GITHUB_REPOSITORY}" \
+            --merge \
+            --subject "chore: sync upstream dev" \
+            --body "Automated upstream dev sync after build and tests passed."
+
+          merged_sha="$(gh pr view "$PR_NUMBER" --repo "${GITHUB_REPOSITORY}" --json mergeCommit --jq '.mergeCommit.oid')"
+          echo "merged_sha=${merged_sha}" >> "$GITHUB_OUTPUT"
+
+      - name: Dispatch Stackray scanner pin update
+        env:
+          STACKRAY_DISPATCH_TOKEN: ${{ secrets.STACKRAY_DISPATCH_TOKEN }}
+          HTTPX_SHA: ${{ steps.merge-pr.outputs.merged_sha }}
+          HTTPX_REF: ${{ env.BASE_BRANCH }}
+        run: |
+          if [ -z "$STACKRAY_DISPATCH_TOKEN" ]; then
+            echo "::notice title=Stackray dispatch skipped::Set STACKRAY_DISPATCH_TOKEN to trigger Stackray scanner pin updates."
+            exit 0
+          fi
+
+          curl -fsSL \
+            -X POST \
+            -H "Accept: application/vnd.github+json" \
+            -H "Authorization: Bearer ${STACKRAY_DISPATCH_TOKEN}" \
+            -H "X-GitHub-Api-Version: 2022-11-28" \
+            https://api.github.com/repos/CarlosCommits/stackray/dispatches \
+            -d "{\"event_type\":\"httpx-dev-updated\",\"client_payload\":{\"httpx_sha\":\"${HTTPX_SHA}\",\"httpx_ref\":\"${HTTPX_REF}\",\"source\":\"sync-upstream-dev\"}}"
+
+  report-failure:
+    name: Report blocked upstream sync
+    needs: [sync, validate, merge]
+    if: always() && (needs.sync.result == 'failure' || needs.validate.result == 'failure' || needs.merge.result == 'failure')
+    runs-on: ubuntu-latest
+    steps:
+      - name: Create or update blocked sync issue
+        env:
+          GH_TOKEN: ${{ secrets.UPSTREAM_SYNC_TOKEN || github.token }}
+          TITLE: Upstream httpx sync blocked
+          SYNC_RESULT: ${{ needs.sync.result }}
+          VALIDATE_RESULT: ${{ needs.validate.result }}
+          MERGE_RESULT: ${{ needs.merge.result }}
+        run: |
+          gh label create upstream-sync \
+            --repo "${GITHUB_REPOSITORY}" \
+            --color "0E8A16" \
+            --description "Automated upstream synchronization" || true
+
+          body_file="$(mktemp)"
+          {
+            echo "The automated upstream sync did not complete."
+            echo
+            echo "- Run: ${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}"
+            echo "- Trigger: ${GITHUB_EVENT_NAME}"
+            echo "- Upstream: ${UPSTREAM_REPOSITORY}:${BASE_BRANCH}"
+            echo "- Sync job: ${SYNC_RESULT}"
+            echo "- Validation job: ${VALIDATE_RESULT}"
+            echo "- Merge job: ${MERGE_RESULT}"
+            echo
+            echo "Review the run logs, resolve merge conflicts or failing tests, then rerun the Sync upstream dev workflow."
+          } > "$body_file"
+
+          issue_number="$(gh issue list \
+            --repo "${GITHUB_REPOSITORY}" \
+            --state open \
+            --search "${TITLE} in:title" \
+            --json number,title \
+            --jq ".[] | select(.title == \"${TITLE}\") | .number" | head -n 1)"
+          if [ -n "$issue_number" ]; then
+            gh issue edit "$issue_number" --repo "${GITHUB_REPOSITORY}" --body-file "$body_file" --add-label upstream-sync
+          else
+            gh issue create --repo "${GITHUB_REPOSITORY}" --title "$TITLE" --body-file "$body_file" --label upstream-sync
+          fi
+
+  close-resolved-issue:
+    name: Close resolved upstream sync issue
+    needs: [sync, validate, merge]
+    if: >-
+      always() &&
+      needs.sync.result == 'success' &&
+      (needs.validate.result == 'success' || needs.validate.result == 'skipped') &&
+      (needs.merge.result == 'success' || needs.merge.result == 'skipped')
+    runs-on: ubuntu-latest
+    steps:
+      - name: Close blocked sync issue
+        env:
+          GH_TOKEN: ${{ secrets.UPSTREAM_SYNC_TOKEN || github.token }}
+          TITLE: Upstream httpx sync blocked
+        run: |
+          issue_number="$(gh issue list \
+            --repo "${GITHUB_REPOSITORY}" \
+            --state open \
+            --search "${TITLE} in:title" \
+            --json number,title \
+            --jq ".[] | select(.title == \"${TITLE}\") | .number" | head -n 1)"
+
+          if [ -n "$issue_number" ]; then
+            gh issue close "$issue_number" \
+              --repo "${GITHUB_REPOSITORY}" \
+              --comment "The upstream sync is no longer blocked. Resolved by ${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}."
+          fi
