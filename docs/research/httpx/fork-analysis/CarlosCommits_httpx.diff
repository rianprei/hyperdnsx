+// closePage closes the page and performs cleanup
+func (b *Browser) closePage(page *rod.Page) {
+	if page == nil {
+		return
+	}
+
+	closePage := page.Context(context.Background()).Timeout(5 * time.Second)
+	defer closePage.CancelTimeout()
+	_ = closePage.Close()
+}
