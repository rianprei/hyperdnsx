+// isSafeRecursiveTarget validates that a value extracted from a server-controlled
+// source (TLS cert fields, CSP headers) is safe to use as a recursive probe target.
+func isSafeRecursiveTarget(value string) bool {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return false
+	}
+	// Valid DNS hostnames never contain commas. Reject to prevent the comma-split
+	// branch in r.targets from synthesizing attacker-chosen Host/CustomHost pairs.
+	if strings.Contains(value, ",") {
+		return false
+	}
+	// Reject whitespace, which could cause unexpected parsing.
+	if strings.ContainsAny(value, " \t\n\r") {
+		return false
+	}
+	// Reject raw IP addresses — recursive probing from cert/CSP data should only
+	// discover new domain names, not allow the server to steer connections to
+	// arbitrary IPs (especially internal/link-local/cloud-metadata addresses).
+	if net.ParseIP(value) != nil {
+		return false
+	}
+	return true
+}
