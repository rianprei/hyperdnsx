-		return errkit.Wrap(err, "could not upload chunk")
-	}
-	// if successful, reset the buffer
-	buff.Reset()
-	// log in verbose mode
-	gologger.Warning().Msgf("Uploaded results chunk, you can view assets at %v", getAssetsDashBoardURL(u.assetGroupID, u.TeamID))
-	return nil
-}
